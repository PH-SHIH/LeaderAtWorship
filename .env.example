# LeaderAtWorship Configuration
# Copy this file to .env and adjust values

# Database
LAW_DATABASE_URL=sqlite+aiosqlite:///./data/db/leader_at_worship.db

# Storage paths
LAW_AUDIO_DIR=data/audio
LAW_EXPORT_DIR=data/exports

# Whisper — mlx-whisper on Apple Silicon
# Models: mlx-community/whisper-large-v3-turbo (recommended), mlx-community/whisper-large-v3-mlx
LAW_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
LAW_WHISPER_LANGUAGE=auto

# Demucs vocal separation — Apple Silicon optimized
# Models: htdemucs (fast/recommended), htdemucs_ft (slow/best), mdx_extra (fastest)
LAW_DEMUCS_MODEL=htdemucs
LAW_DEMUCS_DEVICE=auto
LAW_DEMUCS_SHIFTS=1
LAW_DEMUCS_SEGMENT=7
LAW_DEMUCS_OVERLAP=0.1
LAW_DEMUCS_JOBS=0

# Lyrics alignment
LAW_ALIGNMENT_ENABLED=true
LAW_ALIGNMENT_MATCH_THRESHOLD=0.55
LAW_ALIGNMENT_MIN_CONFIDENCE=0.5
LAW_ALIGNMENT_MIN_MATCH_RATIO=0.4
LAW_ALIGNMENT_BPM_SNAP=false
LAW_ALIGNMENT_BPM_SNAP_TOLERANCE_MS=150

# Anchor-based alignment v2
LAW_ALIGNMENT_ANCHOR_THRESHOLD=0.55
LAW_ALIGNMENT_LOGPROB_THRESHOLD=-0.7
LAW_ALIGNMENT_MIN_ANCHOR_RATIO=0.4
LAW_ALIGNMENT_PHANTOM_THRESHOLD_MS=3000
LAW_ALIGNMENT_OUTPUT_TRADITIONAL=true

# Pipeline concurrency — per-stage semaphores for true pipeline parallelism
# Songs proceed through stages independently; heavy stages (demucs/whisper) are serialized
LAW_MAX_CONCURRENT_PIPELINES=3
LAW_MAX_CONCURRENT_DEMUCS=1
LAW_MAX_CONCURRENT_WHISPER=1

# Server
LAW_HOST=0.0.0.0
LAW_PORT=8000
LAW_DEBUG=true
